{
  "author": "Gautam Keshri",
  "build": {
    "appId": "com.gautamkeshri.interview-assistant",
    "copyright": "Copyright \u00a9 2026 Gautam Keshri",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "artifactName": "Interview-Assistant-${version}.${ext}",
      "category": "public.app-category.productivity",
      "target": [
        {
          "arch": [
            "x64",
            "arm64"
          ],
          "target": "dmg"
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "shortcutName": "Interview Assistant"
    },
    "productName": "Interview Assistant",
    "win": {
      "artifactName": "Interview-Assistant-Setup-${version}.${ext}",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ]
    }
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "description": "Real-time AI interview helper for Windows and macOS — SaaS client. Listens to interviewer audio on Google Meet / Zoom, detects questions, and shows discreet suggested answers. Users sign up / log in; all AI runs through the service backend (no API keys in the app). Use only where live assistance is permitted.",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "license": "MIT",
  "main": "src/main.js",
  "name": "interview-assistant-desktop",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --dir --publish never",
    "start": "electron ."
  },
  "version": "0.3.0"
}